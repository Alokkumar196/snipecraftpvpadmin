{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).child('status').val() === 'active')",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
        ".validate": "newData.hasChildren(['name','role','status'])"
      }
    },

    "registrations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
      "$username": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",

        ".write": "(!data.exists() && auth == null) || (auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active')",

        ".validate": "newData.hasChildren(['minecraftUsername','minecraftUsernameLower','discordUsername','registeredAt','status','source','enrolledBy']) && newData.child('minecraftUsernameLower').val() === $username && newData.child('minecraftUsername').isString() && newData.child('minecraftUsername').val().length >= 3 && newData.child('minecraftUsername').val().length <= 16 && newData.child('status').val() === 'pending' && (newData.child('source').val() === 'public' || newData.child('source').val() === 'admin')"
      }
    },

    "staff": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
      "$staffId": {
        ".validate": "newData.hasChildren(['name','role'])"
      }
    },

    "rules": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
      "$ruleId": {
        ".validate": "newData.hasChildren(['title','description','order','published','createdAt'])"
      }
    },

    "event": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
      "settings": {
        ".validate": "newData.hasChildren(['name'])"
      }
    },

    "winners": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
      "$winnerId": {
        ".validate": "newData.hasChildren(['minecraftUsername','placement'])"
      }
    },

    "announcements": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('status').val() === 'active'",
      "$announcementId": {
        ".validate": "newData.hasChildren(['title','message','published','createdAt'])"
      }
    }
  }
}